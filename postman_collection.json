{
  "info": {
    "name": "Software Factory",
    "description": "Local harness API. Start the server first with `python factory.py`, then run these against http://127.0.0.1:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Run a feature",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/run",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"feature_request\": \"Add a greet(name) helper that says hello\",\n  \"project_path\": \"example-target-project\"\n}"
        }
      }
    },
    {
      "name": "Resume a session",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/sessions/REPLACE_WITH_SESSION_ID/resume"
      }
    },
    {
      "name": "Resume with a budget grant",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/sessions/REPLACE_WITH_SESSION_ID/resume",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grants\": {\"review_retry\": 4},\n  \"grant_reason\": \"unblock the demo\",\n  \"granted_by\": \"operator\"\n}"
        }
      }
    },
    {
      "name": "List sessions",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/sessions"
      }
    },
    {
      "name": "Get one session",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/sessions/REPLACE_WITH_SESSION_ID"
      }
    },
    {
      "name": "Get session report",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/sessions/REPLACE_WITH_SESSION_ID/report"
      }
    },
    {
      "name": "Get session trace (append-only log)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/sessions/REPLACE_WITH_SESSION_ID/trace"
      }
    },
    {
      "name": "View memory (AGENTS.md)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/memory"
      }
    }
  ]
}
