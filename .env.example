# Copy this file to .env and fill in your values.
FACTORY_API_KEY=your-api-key-here

# Base URL of the OpenAI-compatible endpoint. Leave unset to use OpenAI's
# default (https://api.openai.com/v1).
FACTORY_BASE_URL=https://api.openai.com/v1

# Fallback model, used for any role with no tier override below configured.
FACTORY_MODEL=your-model-name-here

# Optional per-tier overrides — see llm_client.py's ROLE_TIERS for which
# role uses which tier. Omit any of these to fall back to FACTORY_MODEL
# for that tier's roles.
# FACTORY_MODEL_SOL=your-flagship-model-name
# FACTORY_MODEL_TERRA=your-mid-tier-model-name
# FACTORY_MODEL_LUNA=your-lightweight-model-name

# What to do when a role's prompt contains credential-shaped content
# (an API key, a private key block, a JWT, ...): "redact" (default) scrubs
# it and continues; "block" raises instead. Optional — omit to use the
# default.
# FACTORY_SECRET_POLICY=redact
